{
  "name": "xtrading-console",
  "version": "0.1.0",
  "private": true,
  "description": "XTrading Console for trading configuration and runtime operations.",
  "scripts": {
    "dev": "max dev",
    "start": "max dev",
    "build": "max build",
    "analyze": "cross-env ANALYZE=1 max build",
    "postinstall": "max setup",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run typecheck && npm run format:check",
    "test:e2e": "playwright test"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead"
  ],
  "dependencies": {
    "@ant-design/icons": "6.3.2",
    "@ant-design/pro-components": "2.8.10",
    "@umijs/max": "4.7.2",
    "@umijs/route-utils": "4.0.3",
    "antd": "5.29.3",
    "classnames": "2.5.1",
    "lightweight-charts": "^5.2.0",
    "lodash": "4.18.1",
    "moment": "2.30.1",
    "omit.js": "2.0.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/lodash": "4.17.25",
    "@types/node": "26.2.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "cross-env": "10.1.0",
    "less": "4.8.1",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  },
  "overrides": {
    "immer": "9.0.21",
    "postcss": "8.5.26",
    "nanoid": "3.3.18",
    "node-fetch": "2.7.0",
    "@ant-design/pro-layout": {
      "path-to-regexp": "8.4.2"
    },
    "@umijs/preset-umi": {
      "path-to-regexp": "1.9.0"
    },
    "@umijs/plugins": {
      "axios": "1.19.0"
    }
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@11.12.1"
}
