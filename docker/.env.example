# Docker Compose host ports
APP_PORT=8000
MYSQL_PORT=3307
REDIS_PORT=6380

# MySQL test database
MYSQL_DATABASE=nofx_admin
MYSQL_USER=nofx
MYSQL_PASSWORD=ChangeThisMysqlPassword123
MYSQL_ROOT_PASSWORD=ChangeThisMysqlRootPassword123

# Redis and application authentication
REDIS_PASSWORD=ChangeThisRedisPassword123
JWT_SIGNING_KEY=ChangeThisJwtSigningKeyWithAtLeast32Chars

# Administrator bootstrap. Leave blank to generate a strong password and print it once.
# The bcrypt hash is persisted in the app-data volume and reused on restart.
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=

# Base64 encoded 32-byte AES key. Replace before the first startup and keep it stable afterwards.
DATA_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
DATA_ENCRYPTION_KEY_PREVIOUS=

# Docker-only Go module proxy; kept separate from the host GOPROXY
DOCKER_GOPROXY=https://goproxy.cn,direct

# Optional Alpine package mirror for local Docker builds
APK_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/alpine
